# Triton config for fraud_mlp. Version 1 = FP32 ONNX, version 2 = INT8 (dynamic quantization).
name: "fraud_mlp"
backend: "onnxruntime"
max_batch_size: 1024

version_policy: { specific: { versions: [1, 2] } }

input [
  { name: "input", data_type: TYPE_FP32, dims: [ 40 ] }
]
output [
  { name: "label", data_type: TYPE_INT64, dims: [ 1 ], reshape: { shape: [ ] } },
  { name: "probabilities", data_type: TYPE_FP32, dims: [ 2 ] }
]

# Merge concurrent single-row requests into GPU-sized batches. Waiting up to
# 500us trades a sliver of latency for far higher throughput under load.
dynamic_batching {
  preferred_batch_size: [ 64, 256, 1024 ]
  max_queue_delay_microseconds: 500
  default_queue_policy { timeout_action: REJECT, default_timeout_microseconds: 100000, allow_timeout_override: true }
}

# Two copies of the model per GPU so one can run while the other is batching.
instance_group [ { count: 2, kind: KIND_GPU } ]

optimization {
  graph: { level: 1 }
  execution_accelerators {
    gpu_execution_accelerator: [ {
      name: "tensorrt"
      parameters { key: "precision_mode" value: "FP16" }
      parameters { key: "max_workspace_size_bytes" value: "1073741824" }
      parameters { key: "trt_engine_cache_enable" value: "true" }
    } ]
  }
}

model_warmup [ {
  name: "warmup_batch"
  batch_size: 64
  inputs { key: "input" value: { data_type: TYPE_FP32, dims: [ 40 ], random_data: true } }
} ]
